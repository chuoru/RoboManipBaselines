@@ -416,6 +447,29 @@ Eigen::Vector3f Frame::GetVelocity() const
 
 void Frame::SetImuPoseVelocity(const Eigen::Matrix3f &Rwb, const Eigen::Vector3f &twb, const Eigen::Vector3f &Vwb)
 {
+    // Rwb comes straight from an inertial pose optimizer's own vertex
+    // estimate, with no validation -- an ill-conditioned/under-constrained
+    // solve can leave it non-finite or non-orthogonal, and Sophus::SE3f's
+    // constructor below asserts the rotation is a valid SO3 element,
+    // aborting the whole process on "R is not orthogonal". Ported from a
+    // gdb-confirmed real-hardware fix (all-zero Rwb observed on real
+    // Insta360 X3 live IMU_MONOCULAR tracking; see
+    // envs/real/insta360_bridge/orb_slam3_hardware_fixes/). Skip this
+    // pose/velocity update rather than crash on a result this
+    // optimization attempt clearly failed to produce validly -- the frame
+    // keeps whatever pose it already had, which is far better than
+    // aborting.
+    const Eigen::Matrix3f orthogonality_error =
+        Rwb * Rwb.transpose() - Eigen::Matrix3f::Identity();
+    if (!Rwb.allFinite() || orthogonality_error.norm() > 1e-2f)
+    {
+        std::cerr << "Frame::SetImuPoseVelocity: rejecting non-finite/"
+                      "non-orthogonal Rwb from inertial pose optimizer, "
+                      "keeping previous pose"
+                   << std::endl;
+        return;
+    }
