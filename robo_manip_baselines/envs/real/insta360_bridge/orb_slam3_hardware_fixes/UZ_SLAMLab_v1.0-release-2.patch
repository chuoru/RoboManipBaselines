 void Preintegrated::IntegrateNewMeasurement(const Eigen::Vector3f &acceleration, const Eigen::Vector3f &angVel, const float &dt)
 {
+    // dt must be strictly positive: every term below (avgA/avgW's
+    // dT+dt denominator, the dR*dt/dt*dt integration steps, JRg/JVg/JPg
+    // bias-Jacobian updates) assumes a forward-in-time step. A
+    // non-positive or non-finite dt here corrupts this object's internal
+    // state PERMANENTLY (dR/JRg etc. accumulate incrementally, so one bad
+    // step poisons every later GetDeltaRotation/GetDeltaVelocity call with
+    // NaN) -- confirmed via gdb on real Insta360 X3 live IMU_MONOCULAR
+    // tracking as the root cause of a "Sophus SO3::exp failed! omega: nan
+    // nan nan" crash inside EdgeInertial::computeError. Skip the update
+    // rather than let a single degenerate step (e.g. from
+    // Tracking::PreintegrateIMU's linear interpolation hitting a
+    // zero/negative time gap between two queued IMU samples) propagate
+    // forever.
+    if (!(dt > 0.0f) || !std::isfinite(dt))
+    {
+        std::cerr << "IMU::Preintegrated::IntegrateNewMeasurement: "
+                      "skipping degenerate step, dt="
+                   << dt << std::endl;
+        return;
+    }
+
     mvMeasurements.push_back(integrable(acceleration,angVel,dt));
 
     // Position is updated firstly, as it depends on previously computed velocity and rotation.
