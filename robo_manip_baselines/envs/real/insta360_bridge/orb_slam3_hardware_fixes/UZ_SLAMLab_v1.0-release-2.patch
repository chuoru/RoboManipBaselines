     std::unique_lock<std::mutex> lock(mMutex);
     Eigen::Vector3f dbg;
     dbg << b_.bwx-b.bwx,b_.bwy-b.bwy,b_.bwz-b.bwz;
-    return NormalizeRotation(dR * Sophus::SO3f::exp(JRg * dbg).matrix());
+    // JRg*dbg is a first-order linearization of how dR changes with bias,
+    // only valid for a small bias delta -- this file's own EdgeInertialGS
+    // ::computeError() TODO already flags this ("Maybe Reintegrate...when
+    // difference between linearization point and current estimate is too
+    // big"). b_ comes from the optimizer's current bias-vertex ESTIMATE,
+    // which can run away (e.g. under a poorly-conditioned/under-excited
+    // inertial optimization) to a value the linearization was never valid
+    // for, producing a non-finite Sophus::SO3f::exp() argument -- confirmed
+    // via gdb on real Insta360 X3 hardware as "SO3::exp failed! omega: nan
+    // nan nan" aborting the process. Skip the (already-invalid) correction
+    // rather than propagate non-finite state into the optimizer.
+    const Eigen::Vector3f domega = JRg * dbg;
+    if (!domega.allFinite())
+    {
+        std::cerr << "IMU::Preintegrated::GetDeltaRotation: bias delta "
+                      "produced a non-finite rotation correction, using "
+                      "uncorrected dR"
+                   << std::endl;
+        return NormalizeRotation(dR);
+    }
+    return NormalizeRotation(dR * Sophus::SO3f::exp(domega).matrix());
 }
 
