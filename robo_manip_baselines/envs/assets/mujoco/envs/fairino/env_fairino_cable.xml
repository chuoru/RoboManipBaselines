<mujoco model="fairino_cable">
  <include file="./env_fairino_common.xml"/>

  <asset>
    <material name="push_block" rgba="0.9 0.5 0.05 1" specular="0.3" shininess="0.2"/>
    <material name="goal_marker" rgba="0.95 0.85 0.1 1" specular="0.0" shininess="0.0" emission="0.3"/>
  </asset>

  <include file="../../robots/fairino5_v6/fairino5_v6_config.xml"/>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3"/>

    <camera name="front" mode="fixed" pos="0.5 0.0 1.5" euler="0.0 0.785398 1.5708"/>
    <camera name="left" mode="fixed" pos="-0.0 -0.65 1.5" euler="0.785398 0.0 0.0"/>
    <camera name="right" mode="fixed" pos="-0.0 0.75 1.5" euler="-0.785398 0.0 3.1415"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <geom name="wall1" type="box" size="10 10 0.01" pos="10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall2" type="box" size="10 10 0.01" pos="-10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall3" type="box" size="10 10 0.01" pos="0 10 10" zaxis="0 1 0" material="wall"/>
    <geom name="wall4" type="box" size="10 10 0.01" pos="0 -10 10" zaxis="0 1 0" material="wall"/>

    <body name="table">
      <geom type="box" size="0.275 0.5 0.4" pos="0 0 0.4" material="table_base"/>
      <geom type="box" size="0.275 0.5 0.0075" pos="0 0 0.8075" material="table_plate"/>
    </body>

    <body name="stand">
      <geom type="box" size="0.33 0.33 0.4" pos="-0.605 0 0.4" material="stand"/>
    </body>

    <body name="fairino5_v6_root_frame" pos="-0.605 0.0 0.8">
      <include file="../../robots/fairino5_v6/fairino5_v6_body.xml"/>
    </body>

    <!-- Goal region: a taped-off 12x12cm square outline, for "push the
         object inside this rectangle" tasks. Positioned ~28cm from
         push_block (x=0.12 y=0.08) along -Y, close enough for a deliberate
         push rather than a long traverse. Purely a visual marking --
         contype/conaffinity=0 so it never collides with anything, like real
         tape wouldn't. Four thin box strips forming a square, each spanning
         the full side length so the corners overlap. -->
    <body name="goal_region" pos="0.12 -0.12 0.8155">
      <geom type="box" size="0.06 0.004 0.0005" pos="0 0.06 0" contype="0" conaffinity="0" material="goal_marker"/>
      <geom type="box" size="0.06 0.004 0.0005" pos="0 -0.06 0" contype="0" conaffinity="0" material="goal_marker"/>
      <geom type="box" size="0.004 0.06 0.0005" pos="0.06 0 0" contype="0" conaffinity="0" material="goal_marker"/>
      <geom type="box" size="0.004 0.06 0.0005" pos="-0.06 0 0" contype="0" conaffinity="0" material="goal_marker"/>
    </body>

    <!-- Push block: a simple 6cm cube to push (not grasp) into goal_region.
         Rests flat on the table (table top z=0.815 -> body z=0.815+0.03),
         positioned close to the arm's reach, ~28cm from goal_region so a
         deliberate push has some distance to cover but isn't a long
         traverse. condim=6/solref/solimp/joint damping carried over from the
         earlier grasp_ring object -- same reasoning applies (torsional/
         rolling friction components need condim>=4 to do anything at all,
         and the softer default contact impedance caused visible jitter for
         small/light free bodies when disturbed). Friction is high (like the
         earlier object) so a push translates the block cleanly instead of
         it skating around unpredictably under the gripper. -->
    <body name="push_block" pos="0.12 0.08 0.845">
      <joint name="push_block" type="free" damping="0.5"/>
      <geom name="push_block" type="box" size="0.03 0.03 0.03" material="push_block" mass="0.08" friction="1.4 0.5 0.05" condim="6" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    </body>
  </worldbody>
</mujoco>
