<mujoco model="fairino_cable">
  <include file="./env_fairino_common.xml"/>

  <asset>
    <texture name="pole" file="general/metal2.png" type="cube"/>
    <material name="pole" texture="pole" rgba="0.8 0 0 1" specular="1.0" shininess="1.0"/>
    <material name="grasp_cylinder" rgba="0.9 0.5 0.05 1" specular="0.3" shininess="0.2"/>
  </asset>

  <include file="../../robots/fairino5_v6/fairino5_v6_config.xml"/>

  <include file="../../objects/cable/cable_config.xml"/>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3"/>

    <camera name="front" mode="fixed" pos="0.5 0.0 1.5" euler="0.0 0.785398 1.5708"/>
    <camera name="left" mode="fixed" pos="-0.0 -0.65 1.5" euler="0.785398 0.0 0.0"/>
    <camera name="right" mode="fixed" pos="-0.0 0.75 1.5" euler="-0.785398 0.0 3.1415"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <geom name="wall1" type="box" size="10 10 0.01" pos="10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall2" type="box" size="10 10 0.01" pos="-10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall3" type="box" size="10 10 0.01" pos="0 10 10" zaxis="0 1 0" material="wall"/>
    <geom name="wall4" type="box" size="10 10 0.01" pos="0 -10 10" zaxis="0 1 0" material="wall"/>

    <body name="table">
      <geom type="box" size="0.275 0.5 0.4" pos="0 0 0.4" material="table_base"/>
      <geom type="box" size="0.275 0.5 0.0075" pos="0 0 0.8075" material="table_plate"/>
    </body>

    <body name="stand">
      <geom type="box" size="0.33 0.33 0.4" pos="-0.605 0 0.4" material="stand"/>
    </body>

    <body name="fairino5_v6_root_frame" pos="-0.605 0.0 0.8">
      <include file="../../robots/fairino5_v6/fairino5_v6_body.xml"/>
    </body>

    <body name="cable" pos="-0.175 0.2 0.8325" quat="0.707105 0 0 -0.707108">
      <include file="../../objects/cable/cable_body.xml"/>
    </body>

    <body name="cable_end" pos="-0.175 -0.28 0.8325" euler="0 0 -1.5708">
      <freejoint/>
      <geom type="box" size="0.02 0.015 0.015" pos="0.0 0.0 0.0" material="cable_box"/>
    </body>

    <body name="poles" pos="-0.1 0.1 0.795">
      <geom name="pole1" type="cylinder" size="0.01 0.03" pos="0.0 0.0 0.05" material="pole"/>
      <geom name="pole2" type="cylinder" size="0.01 0.03" pos="0.05 0.0 0.05" material="pole"/>
    </body>

    <!-- Cylinder with a ring/handle on top, easy for the parallel gripper to
         hook/pinch (MuJoCo has no torus primitive, so the ring is approximated
         with 16 capsule segments arranged in a circle -- radius 0.025m,
         tube radius 0.005m, comparable thickness to the cable so the fingers
         can close around it). The ring stands on a short stem above the
         cylinder, in the Y-Z plane (hole facing +-X) so a gripper reaching
         horizontally along X can pass its fingers through the hole and close
         on the ring's near/far tube sides (separated along Y, the gripper's
         finger-open/close axis -- see teleop discussion on the "pinch" site's
         local-Y reach convention). All geoms share one body/freejoint since
         it's a single rigid object.
         Table top z=0.815, center x=0 y=0 (table body has no offset from
         world origin; table half-extent in x is 0.275). Body origin is
         positioned 20cm further from the robot base (base at x=-0.605) than
         table center, i.e. toward the table's far/deep side, leaving a 7.5cm
         margin to the table edge. -->
    <body name="grasp_ring" pos="0.2 0 0.845">
      <freejoint/>
      <geom name="grasp_cylinder" type="cylinder" size="0.02 0.03" material="grasp_cylinder" mass="0.05" friction="1.0 0.005 0.0001"/>
      <geom type="cylinder" size="0.006 0.01" pos="0 0 0.04" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.00000 0.10000 0.00000 0.00957 0.09810" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.00957 0.09810 0.00000 0.01768 0.09268" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.01768 0.09268 0.00000 0.02310 0.08457" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.02310 0.08457 0.00000 0.02500 0.07500" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.02500 0.07500 0.00000 0.02310 0.06543" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.02310 0.06543 0.00000 0.01768 0.05732" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.01768 0.05732 0.00000 0.00957 0.05190" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.00957 0.05190 0.00000 0.00000 0.05000" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 0.00000 0.05000 0.00000 -0.00957 0.05190" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.00957 0.05190 0.00000 -0.01768 0.05732" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.01768 0.05732 0.00000 -0.02310 0.06543" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.02310 0.06543 0.00000 -0.02500 0.07500" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.02500 0.07500 0.00000 -0.02310 0.08457" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.02310 0.08457 0.00000 -0.01768 0.09268" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.01768 0.09268 0.00000 -0.00957 0.09810" material="grasp_cylinder"/>
      <geom type="capsule" size="0.005" fromto="0.00000 -0.00957 0.09810 0.00000 0.00000 0.10000" material="grasp_cylinder"/>
    </body>
  </worldbody>

  <equality>
    <weld name="cable_end" body1="cable_B24" body2="cable_end" relpose="0 0 0 1 0 0 0"/>
  </equality>

  <contact>
    <exclude body1="cable_B0" body2="cable_B1"/>
    <exclude body1="cable_B23" body2="cable_end"/>
    <exclude body1="cable_B24" body2="cable_end"/>
  </contact>
</mujoco>
